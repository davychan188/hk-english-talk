# Required for live AI chat + Whisper STT fallback + OpenAI TTS (without this, demo mode)
OPENAI_API_KEY=sk-...

# Optional alias (either OPENAI_API_KEY or AI_API_KEY works)
# AI_API_KEY=sk-...

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=nova

# Browser Web Speech API (mic + speechSynthesis) needs NO env vars — works in demo mode.
