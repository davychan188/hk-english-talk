# xAI Grok — required for live chat + grammar + feedback (without this → demo mode)
XAI_API_KEY=xai-...

# Optional alias
# GROK_API_KEY=xai-...

# Optional model override (default: grok-3-mini)
# XAI_MODEL=grok-3-mini
# GROK_MODEL=grok-3-mini

# Optional API base (default: https://api.x.ai/v1)
# XAI_BASE_URL=https://api.x.ai/v1

# Browser Web Speech API (mic en-GB + British speechSynthesis) needs NO env vars.
# OpenAI keys are NOT used for chat. Server Whisper/TTS are disabled.
